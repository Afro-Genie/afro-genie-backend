{
  "name": "afro-genie-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx --no-install prisma generate 2>/dev/null || node node_modules/prisma/build/index.js generate && tsc -p tsconfig.json",
    "start": "node scripts/railway-preflight.cjs && prisma migrate deploy && prisma generate && node dist/index.js",
    "lint": "npm run prisma:generate && tsc --noEmit && npm run test:typecheck",
    "type-check": "npm run prisma:generate && tsc --noEmit",
    "test:typecheck": "prisma generate && tsc --noEmit -p tsconfig.test.json",
    "//SAFETY": "REMEDIATION-PLAN.md Stage 7 closed the root cause (audit 1.5.3 / 13.1). Every test command below routes through `node scripts/run-tests.cjs`, which forces NODE_ENV=test, loads `.env.test` (disposable PostgreSQL + Redis on loopback, provisioned by `npm run test:db:up`), and fails closed unless DATABASE_URL, DIRECT_URL, REDIS_URL and TEST_API_URL all resolve to disposable targets. The runner REFUSES ALLOW_PROD_TESTS: the override is no longer reachable from the default path. Two production incidents motivated this (audit 1 and 12.4): a Phase 4 run wrote stub data onto a real catalog Song, and test:phases-3-6 registered ~100 real Users against a live API. Stage 7.7 REMOVED every test that could write to a non-disposable database. The `src/__tests__/integration/*.test.ts` HTTP acceptance scripts are gone: they talked to a separately-started API over the network, so no client-side guard could prove that API's own DATABASE_URL was the disposable one - a loopback URL alone is not proof. There is therefore no test in this repo that trusts TEST_API_URL to reach anything. Coverage that those scripts claimed is now in-process, where isolation is provable: test/phase5ChallengeAndEconomy.tierA|tierB.test.ts (challenges, rewards, economy, abuse, admin matrix) plus the existing test/*.test.ts service suites. See REMEDIATION-RESULTS.md 7.7.",
    "test:db:up": "node scripts/test-db.cjs up",
    "test:db:down": "node scripts/test-db.cjs down",
    "test:db:reset": "node scripts/test-db.cjs reset",
    "test:db:status": "node scripts/test-db.cjs status",
    "test:db:verify": "node scripts/test-db.cjs verify",
    "test": "node scripts/run-tests.cjs",
    "test:safe": "node scripts/run-tests.cjs test/phase6WorkerOptimization.test.ts",
    "test:schema": "node --import ./scripts/load-test-env.cjs --import ./scripts/assert-safe-tests.cjs --import tsx scripts/test-schema.ts",
    "test:translations": "node --import ./scripts/load-test-env.cjs --import ./scripts/assert-safe-tests.cjs --import tsx scripts/translation-acceptance-test.ts",
    "test:lyrics-enrichment": "node --import ./scripts/load-test-env.cjs --import ./scripts/assert-safe-tests.cjs --import tsx scripts/lyrics-enrichment-acceptance-test.ts",
    "test:release-publish": "node --import ./scripts/load-test-env.cjs --import ./scripts/assert-safe-tests.cjs --import tsx scripts/release-publish-acceptance-test.ts",
    "test:community": "node --import ./scripts/load-test-env.cjs --import ./scripts/assert-safe-tests.cjs --import tsx scripts/community-acceptance-test.ts",
    "search:index": "tsx scripts/indexExistingSongs.ts",
    "spotify:backfill": "tsx scripts/backfillSpotifyIds.ts",
    "spotify:backfill:dry": "tsx scripts/backfillSpotifyIds.ts --dry-run",
    "search:bulk": "tsx -e \"import('./src/services/searchService').then((m)=>m.bulkIndex())\"",
    "docs:api:generate": "tsx scripts/generate-openapi-json.ts",
    "docs:api:build": "npm run docs:api:generate",
    "prisma:generate": "prisma generate",
    "secrets:scan": "node scripts/scan-secrets.cjs",
    "secrets:scan:staged": "node scripts/scan-secrets.cjs --staged",
    "secrets:scan:history": "node scripts/scan-secrets.cjs --history",
    "prisma:seed": "prisma db seed",
    "seed:batch": "tsx scripts/batch-seed.ts",
    "seed:resume": "tsx scripts/batch-seed.ts --resume",
    "seed:monitor": "tsx scripts/seed-monitor.ts",
    "seed:status": "tsx scripts/seed-monitor.ts --once",
    "link:data": "tsx scripts/link-song-data.ts",
    "link:dry": "tsx scripts/link-song-data.ts --dry-run",
    "link:genres": "tsx scripts/link-song-data.ts --genres-only",
    "link:languages": "tsx scripts/link-song-data.ts --languages-only",
    "db:status": "tsx scripts/db-status.ts",
    "seed:community": "tsx scripts/seed-community.ts",
    "seed:robust": "tsx scripts/robust-seed.ts",
    "seed:robust:resume": "tsx scripts/robust-seed.ts --resume",
    "seed:robust:status": "tsx scripts/robust-seed.ts --status",
    "audit:seed": "tsx scripts/audit-seed-data.ts",
    "audit:artists": "tsx scripts/audit-artists.ts",
    "audit:artists:json": "tsx scripts/audit-artists.ts --json",
    "backfill:artists": "tsx scripts/backfill-artists.ts",
    "backfill:artists:dry": "tsx scripts/backfill-artists.ts --dry-run",
    "backfill:artists:priority": "tsx scripts/backfill-artists.ts --priority",
    "backfill:artists:priority:dry": "tsx scripts/backfill-artists.ts --priority --dry-run",
    "seed:full": "tsx scripts/scheduled-seed.ts",
    "seed:artist-portal": "tsx scripts/seed-artist-portal.ts",
    "seed:rewards": "tsx prisma/seed-rewards.ts",
    "seed:gt-bundles": "tsx prisma/seedGtBundles.ts",
    "seed:store": "tsx prisma/seedStore.ts",
    "seed:phase2": "npm run seed:gt-bundles && npm run seed:store && npm run seed:challenges",
    "seed:challenges": "tsx prisma/seed-challenges.ts",
    "backup:full": "node scripts/backup-db.cjs",
    "backup:critical": "tsx scripts/backup-critical-data.ts",
    "restore:full": "node scripts/restore-all.js",
    "restore:full:dry": "node scripts/restore-all.js --dry-run",
    "db:integrity": "node scripts/db-integrity.cjs",
    "db:preflight": "node scripts/railway-preflight.cjs",
    "db:guard": "node scripts/guard-prisma.cjs",
    "migrate:dev": "node scripts/guard-prisma.cjs migrate dev",
    "migrate:reset": "node scripts/guard-prisma.cjs migrate reset",
    "db:push": "node scripts/guard-prisma.cjs db push",
    "db:setup": "node scripts/guard-prisma.cjs db setup",
    "cleanup:backup": "tsx scripts/backup-critical-data.ts",
    "cleanup:audit:typesense": "tsx scripts/audit-typesense-stale.ts",
    "cleanup:audit:orphans": "tsx scripts/audit-orphaned-records.ts",
    "cleanup:typesense:dry": "tsx scripts/clean-typesense-stale.ts",
    "cleanup:typesense:apply": "tsx scripts/clean-typesense-stale.ts --apply",
    "cleanup:cache": "tsx scripts/clear-caches.ts",
    "cleanup:reindex": "tsx -e \"import('./src/services/searchService').then((m)=>m.bulkIndex())\""
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.22.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "franc-min": "^6.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "typesense": "^2.0.0-rc.2",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
