# Committed, secret-free isolation contract for backend CI tests.
NODE_ENV=test
DATABASE_URL=postgresql://afrogenie:afrogenie@127.0.0.1:55432/afrogenie?schema=public
DIRECT_URL=postgresql://afrogenie:afrogenie@127.0.0.1:55432/afrogenie?schema=public
