TEST_API_URL=http://127.0.0.1:4000
TEST_DB_HOSTS=127.0.0.1,localhost
TEST_REDIS_HOSTS=127.0.0.1,localhost
TEST_API_HOSTS=127.0.0.1,localhost
ALLOW_PROD_TESTS=

# Required application configuration for test boot.
