# Core
NODE_ENV=development
PORT=3001
CLIENT_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
APP_VERSION=1.0.0

# Data stores
DATABASE_URL=postgresql://user:password@localhost:5432/afro_genie
REDIS_URL=redis://localhost:6379

# Shadow database, used ONLY by `prisma migrate dev` / `migrate reset`.
# `db push` and `migrate deploy` do not read it, so leaving this unset does not
# affect a deploy. It MUST be a disposable database: migrate dev drops and
# recreates it on every run, and prisma.config.ts refuses to start if it points
# at the same database as DATABASE_URL.
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/afrogenie_shadow

# Connection strings for the one-off inspection/transfer scripts at the repo
# root (copy-violet.js, survey-tables.js, inspect-*.js, verify-copy.js). Those
# scripts used to carry these inline and now refuse to run unless they are set.
# Set them in .env.local, which is git-ignored. Leave blank here.
VIOLET_DATABASE_URL=
RICE_DATABASE_URL=

# Search
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=replace_with_typesense_key
TYPESENSE_TIMEOUT_MS=2000

# Auth
JWT_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3001/api/auth/google/callback

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# AI
GEMINI_API_KEY=replace_with_gemini_key
AI_PROVIDER=
AI_TRANSLATION_PROVIDER=gemini

# YouTube Data API v3 (Phase 3 playback fallback — optional)
# Without this key, songs fall back to the Spotify 30s preview.
YOUTUBE_API_KEY=

# Last.fm artist enrichment (optional). Register a key at
# https://www.last.fm/api/account/create — scripts/backfill-artists.ts refuses to
# run without it rather than sending an empty api_key and 403-ing on every row.
LASTFM_API_KEY=

# Phase 4 playback rollout flag (default OFF)
# When off, the legacy Spotify player is used and the library-enrichment job
# stays idle. Gradual rollout: staging -> production -> 100%.
FLAG_PLAYBACK_YOUTUBE=false

# GT payments (Paystack)
#
# REQUIRED when NODE_ENV=production: a payment-enabled deploy refuses to boot
# without all three, rather than 503-ing at runtime when a customer tries to pay.
# Optional in development and test, where the 503 path is the honest answer.
#
# CALLBACK vs WEBHOOK — two different URLs, and swapping them breaks checkout:
#   * PAYSTACK_CALLBACK_URL — where Paystack redirects the BUYER'S BROWSER after
#     checkout. Must be a FRONTEND page on this app (e.g. .../buy-gt), never the
#     API host. Sent per-transaction in transaction/initialize.
#   * The webhook — server-to-server, and the only path that actually credits GT.
#     NOT configured here. Register it in the Paystack dashboard (Settings →
#     API Keys & Webhooks) as: <backend-host>/api/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
