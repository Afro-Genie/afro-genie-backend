generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  ARTIST
}

enum LyricSourceProvider {
  MANUAL
  MUSICMATCH
  LYRICFIND
  GENIUS
  ARTIST
  LRCLIB
}

enum LicenseStatus {
  UNKNOWN
  LICENSED
  UNLICENSED
  TAKEDOWN
}

enum TranslationStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum TopicCategory {
  GENERAL
  LYRICS
  TRANSLATION
  SONG_DISCUSSION
  ARTIST_DISCUSSION
  ANNOUNCEMENT
}

enum NotificationType {
  SYSTEM
  MODERATION
  TRANSLATION
  TOPIC
  COMMENT
  REWARD
  FLAGGED_CONTENT
}

enum ReportStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum BadgeType {
  EARLY_ADOPTER
  TOP_TRANSLATOR
  CULTURE_CURATOR
  COMMUNITY_HELPER
  ARTIST_SPOTLIGHT
  DAILY_STREAK_7
  FIRST_PROFILE
  GENEROUS_SUPPORTER
  SEASON_CHAMPION
  REFERRAL_STAR
  GUARDIAN
  HELPFUL_VOTER
  GENIUS_ARTIST
  MODERATION_QUEUE
  PLATINUM_ARTIST
  FAN_FAVORITE
}

enum ArtistApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum RoleRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
}

enum ReleaseStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  passwordHash               String?
  googleId                   String?                   @unique
  spotifyId                  String?                   @unique
  spotifyProduct             String?
  displayName                String?
  photoUrl                   String?
  role                       UserRole                  @default(USER)
  schemaVersion              Int                       @default(1)
  referralCode               String?                   @unique
  referredByUserId           String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  lastLoginAt                DateTime?
  moderatorPinnedAt          DateTime?
  translations               Translation[]
  translationVotes           TranslationVote[]
  corrections                TranslationCorrection[]
  translationRequests        TranslationRequest[]
  songRequests               SongRequest[]
  topics                     Topic[]
  topicComments              TopicComment[]            @relation("TopicCommentAuthor")
  notifications              Notification[]
  badges                     UserBadge[]
  tokenRewards               TokenReward[]
  artistApplications         ArtistApplication[]
  reviewedArtistApplications ArtistApplication[]       @relation("ReviewedByUser")
  roleRequests               RoleRequest[]
  communityMemberships       UserCommunityMembership[]
  topicVotes                 TopicVote[]
  topicCommentVotes          TopicCommentVote[]
  topicViews                 TopicView[]
  artist                     Artist?
  songPlays                  SongPlay[]
  favorites                  Favorite[]
  historyEntries             UserHistory[]
  referredUsers              User[]                     @relation("ReferralChain")
  referrer                   User?                      @relation("ReferralChain", fields: [referredByUserId], references: [id], onDelete: SetNull)
  storePurchases             StorePurchase[]
  contentReports             ContentReport[]               @relation("ContentReport_reporter")
  moderatedReports           ContentReport[]               @relation("ContentReport_moderator")
  modActionLogs              ModActionLog[]
  applicationRecommendations ArtistApplicationRecommendation[]
  correctionRequests          CorrectionRequest[]
  resolvedCorrectionRequests  CorrectionRequest[]            @relation("CorrectionRequestResolver")
  correctedTranslations       Translation[]                  @relation("CorrectedTranslations")
  listeningPreference         UserListeningPreference?
  playlists                   Playlist[]
  playlistLikes               PlaylistLike[]

  @@index([role])
  @@index([lastLoginAt])
}

model Artist {
  id              String                 @id @default(cuid())
  userId          String?                @unique
  user            User?                  @relation(fields: [userId], references: [id])
  name            String                 @unique
  bio             String?
  imageUrl        String?
  profileImageUrl String?
  bannerImageUrl  String?
  socialLinks     Json?
  spotifyId       String?                @unique
  spotifyArtistId String?
  genres          String[]
  popularity      Int                    @default(0)
  followers       Int                    @default(0)
  externalUrl     String?
  verified        Boolean                @default(false)
  suspended       Boolean                @default(false)
  isFeatured      Boolean                @default(false)
  softDeleted     Boolean                @default(false)
  schemaVersion   Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  albums          Album[]
  songs           Song[]
  topics          Topic[]
  releases        Release[]
  analytics       ArtistAnalyticsDaily[]
  listenerRegions ArtistListenerRegion[]
  notifications   ArtistNotification[]

  @@index([verified])
  @@index([softDeleted])
  @@index([suspended])
  @@index([isFeatured])
  @@index([popularity])
  @@index([followers])
  @@index([userId])
}

model Album {
  id          String   @id @default(cuid())
  name        String
  artistId    String
  imageUrl    String?
  spotifyId   String?  @unique
  releaseYear Int?
  totalTracks Int?
  popularity  Int      @default(0)
  genres      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs       Song[]

  @@index([artistId])
  @@index([spotifyId])
  @@index([releaseYear])
}

model Song {
  id                  String               @id @default(cuid())
  title               String
  artistId            String
  albumName           String?
  albumId             String?
  releaseId           String?
  releaseYear         Int?
  imageUrl            String?
  spotifyId           String?              @unique
  spotifyPreviewUrl   String?
  previewAvailable    Boolean?
  durationMs          Int?
  trackNumber         Int?
  views               Int                  @default(0)
  requestCount        Int                  @default(0)
  softDeleted         Boolean              @default(false)
  schemaVersion       Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  artist              Artist               @relation(fields: [artistId], references: [id], onDelete: Restrict)
  album               Album?               @relation(fields: [albumId], references: [id], onDelete: SetNull)
  release             Release?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  songLanguages       SongLanguage[]
  lyrics              Lyric[]
  translations        Translation[]
  translationRequests TranslationRequest[]
  genres              SongGenre[]
  topics              Topic[]
  songPlays           SongPlay[]
  correctionRequests  CorrectionRequest[]
  favoritedBy         Favorite[]
  viewedBy            UserHistory[]

  @@unique([title, artistId])
  @@index([artistId])
  @@index([releaseId])
  @@index([title])
  @@index([releaseYear])
  @@index([views])
  @@index([requestCount])
  @@index([softDeleted])
  @@index([previewAvailable])
  @@index([createdAt])
}

model SongLanguage {
  id           String   @id @default(cuid())
  songId       String
  languageCode String
  percentage   Float
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@unique([songId, languageCode])
  @@index([songId])
  @@index([languageCode])
  @@index([languageCode, percentage])
}

model Lyric {
  id             String              @id @default(cuid())
  songId         String
  content        String?             @db.Text
  syncedLyrics   String?             @db.Text
  lyricLines     Json?
  sourceProvider LyricSourceProvider
  licenseStatus  LicenseStatus       @default(UNKNOWN)
  schemaVersion  Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  song           Song                @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId])
  @@index([sourceProvider])
  @@index([licenseStatus])
}

model Language {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  isActive      Boolean        @default(true)
  songLanguages SongLanguage[]

  @@index([isActive])
}

model Translation {
  id               String                  @id @default(cuid())
  songId           String
  userId           String
  originalLyrics   String                  @db.Text
  translatedLyrics String                  @db.Text
  culturalContext  String?                 @db.Text
  sourceLang       String
  targetLang       String
  status           TranslationStatus       @default(PENDING)
  upvotes          Int                     @default(0)
  downvotes        Int                     @default(0)
  aiModel          String?
  promptVersion    String?
  schemaVersion    Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  song             Song                    @relation(fields: [songId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes            TranslationVote[]
  corrections            TranslationCorrection[]
  correctionRequests      CorrectionRequest[]         @relation("TranslationCorrectionRequests")
  correctedById           String?                     @map("corrected_by_id")
  correctedBy             User?                       @relation("CorrectedTranslations", fields: [correctedById], references: [id], onDelete: SetNull)
  correctionRequestId     String?                    @unique
  correctionRequest       CorrectionRequest?          @relation("TranslationResolvedByRequest", fields: [correctionRequestId], references: [id], onDelete: SetNull)
  correctedAt             DateTime?

  @@unique([songId, userId, sourceLang, targetLang])
  @@index([songId])
  @@index([userId])
  @@index([status])
  @@index([sourceLang])
  @@index([targetLang])
  @@index([createdAt])
}

model TranslationVote {
  id            String      @id @default(cuid())
  translationId String
  userId        String
  voteType      VoteType
  createdAt     DateTime    @default(now())
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([translationId, userId])
  @@index([translationId])
  @@index([userId])
  @@index([voteType])
}

model TranslationCorrection {
  id            String           @id @default(cuid())
  translationId String
  userId        String
  originalText  String           @db.Text
  suggestedText String           @db.Text
  reason        String?
  status        CorrectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  translation   Translation      @relation(fields: [translationId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([translationId])
  @@index([userId])
  @@index([status])
}

model TranslationRequest {
  id        String        @id @default(cuid())
  songId    String
  userId    String
  status    RequestStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  song      Song          @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CorrectionRequest {
  id             String           @id @default(cuid())
  songId         String
  translationId  String?
  userId         String
  title          String
  description    String           @db.Text
  status         CorrectionStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  moderatorNote  String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  song         Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  translation  Translation? @relation("TranslationCorrectionRequests", fields: [translationId], references: [id], onDelete: SetNull)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy          User?        @relation("CorrectionRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedTranslation Translation? @relation("TranslationResolvedByRequest")

  @@unique([songId, userId, title])
  @@index([songId])
  @@index([userId])
  @@index([status])
  @@index([translationId])
}

model SongRequest {
  id        String        @id @default(cuid())
  songTitle String
  artist    String
  userId    String
  status    RequestStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([songTitle])
  @@index([artist])
  @@index([createdAt])
}

model AICallLog {
  id               String   @id @default(cuid())
  provider         String
  model            String
  promptVersion    String
  tokensInput      Int
  tokensOutput     Int
  estimatedCostUsd Float
  songId           String?
  userId           String?
  createdAt        DateTime @default(now())

  @@index([provider])
  @@index([songId])
  @@index([userId])
  @@index([createdAt])
}

model Genre {
  id       String      @id @default(cuid())
  name     String      @unique
  imageUrl String?
  songs    SongGenre[]
}

model SongGenre {
  songId  String
  genreId String
  song    Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([songId, genreId])
  @@index([songId])
  @@index([genreId])
}

model ForumCategory {
  id              String                    @id @default(cuid())
  name            String                    @unique
  description     String?
  icon            String?
  order           Int                       @default(0)
  topicCount      Int                       @default(0)
  isModeratorOnly Boolean                   @default(false)
  topics          Topic[]
  memberships     UserCommunityMembership[]

  @@index([order])
  @@index([topicCount])
}

model Topic {
  id              String         @id @default(cuid())
  title           String
  content         String         @db.Text
  authorId        String
  category        TopicCategory
  forumCategoryId String?
  songId          String?
  artistId        String?
  imageUrl        String?
  likes           Int            @default(0)
  shares          Int            @default(0)
  commentCount    Int            @default(0)
  isPinned        Boolean        @default(false)
  isLocked        Boolean        @default(false)
  isModeratorOnly Boolean        @default(false)
  viewCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  song            Song?          @relation(fields: [songId], references: [id], onDelete: SetNull)
  artist          Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  forumCategory   ForumCategory? @relation(fields: [forumCategoryId], references: [id], onDelete: SetNull)
  comments        TopicComment[] @relation("TopicComments")
  votes           TopicVote[]
  views           TopicView[]

  @@index([authorId])
  @@index([songId])
  @@index([artistId])
  @@index([forumCategoryId])
  @@index([category])
  @@index([isPinned])
  @@index([isLocked])
  @@index([createdAt])
}

model TopicComment {
  id              String             @id @default(cuid())
  topicId         String
  userId          String
  content         String             @db.Text
  likes           Int                @default(0)
  parentCommentId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  topic           Topic              @relation("TopicComments", fields: [topicId], references: [id], onDelete: Cascade)
  user            User               @relation("TopicCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parentComment   TopicComment?      @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         TopicComment[]     @relation("CommentThread")
  votes           TopicCommentVote[]

  @@index([topicId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
}

model TopicVote {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  voteType  VoteType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

model TopicView {
  id        String   @id @default(cuid())
  topicId   String
  userId    String?
  viewedAt  DateTime @default(now())
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([userId])
  @@index([viewedAt])
}

model UserListeningPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  genreIds          String[]
  languageCodes     String[]
  listenedArtistIds String[]
  lastComputedAt    DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  songIds     String[]
  createdBy   String
  isPublic    Boolean        @default(true)
  likeCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  creator     User           @relation(fields: [createdBy], references: [id])
  likes       PlaylistLike[]

  @@index([createdBy])
  @@index([isPublic])
  @@index([likeCount])
  @@index([createdAt])
}

model PlaylistLike {
  id         String   @id @default(cuid())
  userId     String
  playlistId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId])
  @@index([userId])
  @@index([playlistId])
}

model TopicCommentVote {
  id        String       @id @default(cuid())
  userId    String
  commentId String
  voteType  VoteType
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   TopicComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model UserCommunityMembership {
  id         String        @id @default(cuid())
  userId     String
  categoryId String
  joinedAt   DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badgeType BadgeType
  earnedAt  DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
  @@index([badgeType])
}

model TokenReward {
  id              String   @id @default(cuid())
  userId          String
  amount          Int
  reason          String
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model ArtistApplication {
  id               String                  @id @default(cuid())
  userId           String
  stageName        String
  genre            String
  bio              String
  socialLinks      Json
  imageUrl         String?
  spotifyArtistId  String?
  status           ArtistApplicationStatus @default(PENDING)
  rejectionReason  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                   @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  recommendations  ArtistApplicationRecommendation[]

  @@index([userId])
  @@index([status])
  @@index([stageName])
  @@index([reviewedByUserId])
}

model RoleRequest {
  id         String            @id @default(cuid())
  userId     String
  role       UserRole
  status     RoleRequestStatus @default(PENDING)
  fields     Json
  notes      String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Release {
  id            String        @id @default(cuid())
  artistId      String
  title         String
  type          ReleaseType
  coverImageUrl String?
  releaseDate   DateTime
  status        ReleaseStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  artist        Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs         Song[]

  @@index([artistId])
  @@index([status])
  @@index([releaseDate])
}

model ArtistAnalyticsDaily {
  id               String   @id @default(cuid())
  artistId         String
  date             DateTime
  plays            Int      @default(0)
  translationViews Int      @default(0)
  uniqueListeners  Int      @default(0)
  createdAt        DateTime @default(now())
  artist           Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@index([artistId])
  @@index([date])
}

model ArtistNotification {
  id        String   @id @default(cuid())
  artistId  String
  type      String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([isRead])
  @@index([createdAt])
}

model SongPlay {
  id       String   @id @default(cuid())
  songId   String
  playedAt DateTime @default(now())
  userId   String?
  country  String?
  city     String?
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([songId, playedAt])
  @@index([playedAt])
  @@index([userId])
  @@index([country])
}

model ArtistListenerRegion {
  id        String   @id @default(cuid())
  artistId  String
  date      DateTime
  country   String
  city      String
  listeners Int      @default(0)
  plays     Int      @default(0)
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date, country, city])
  @@index([artistId])
  @@index([date])
  @@index([country])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
}

model SyncRun {
  id          String   @id @default(cuid())
  type        String
  startedAt   DateTime
  completedAt DateTime
  songsAdded  Int      @default(0)
  artistsUpdated Int   @default(0)
  errors      Int      @default(0)
  durationMs  Int
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([startedAt])
  @@index([createdAt])
}

model UserHistory {
  id       String   @id @default(cuid())
  userId   String
  songId   String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([songId])
}

// ── Phase 6: Feature Expansion ──────────────────────────────

model StoreItem {
  id          String   @id @default(cuid())
  name        String
  description String
  tokenCost   Int
  category    String   @default("cosmetic")
  metadata    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases   StorePurchase[]
}

model StorePurchase {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  spentAmount Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, createdAt])
  @@index([userId])
  @@index([itemId])
  @@index([createdAt])
}

model ContentReport {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  description  String?
  status       ReportStatus @default(PENDING)
  moderatorId  String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade, name: "ContentReport_reporter")
  moderator    User?        @relation(fields: [moderatorId], references: [id], onDelete: SetNull, name: "ContentReport_moderator")

  @@index([reporterId])
  @@index([moderatorId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  period     String
  startDate  DateTime
  endDate    DateTime
  data       Json
  createdAt  DateTime @default(now())

  @@unique([period, startDate])
  @@index([period])
  @@index([startDate])
}

model ModActionLog {
  id            String   @id @default(cuid())
  moderatorId   String?
  actionType    String
  targetId      String
  targetType    String
  details       String?
  createdAt     DateTime @default(now())

  moderator     User?    @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([moderatorId])
  @@index([actionType])
  @@index([targetId, targetType])
  @@index([createdAt])
}

model CommunityGuideline {
  id        String   @id @default(cuid())
  content   String   @db.Text
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtistApplicationRecommendation {
  id            String   @id @default(cuid())
  applicationId String
  moderatorId   String
  notes         String
  createdAt     DateTime @default(now())

  application   ArtistApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  moderator     User              @relation(fields: [moderatorId], references: [id])

  @@unique([applicationId, moderatorId])
  @@index([applicationId])
  @@index([moderatorId])
}
